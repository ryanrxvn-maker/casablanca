
# Modelos RNNoise sao texto ASCII parseado byte-exato pelo arnndn do ffmpeg:
# CRLF do autocrlf no Windows quebra o "Error initializing filter arnndn".
*.rnnn -text

# Instalador do Motor macOS: CRLF quebra shell script em TODA linha
# ("bash: $'': command not found"). Trava LF mesmo com autocrlf=true.
*.sh text eol=lf
