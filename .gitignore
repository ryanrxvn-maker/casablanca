# misc
# next.js
# production
# scripts de teste descartaveis
# testing
# typescript
# vercel
*.pem
*.tsbuildinfo
.DS_Store
.env
.env*.local
.pnp.js
.vercel
/.claude/scheduled_tasks.lock
/.claude/worktrees/
/.next/
/.pnp
/.test-tmp/
/build
/coverage
# O bundle do motor PRECISA ir pro git: a rota /api/downloader-engine/mac
# le esse arquivo do disco em runtime, e a Vercel so embarca o que esta
# commitado. Foi exatamente assim que o pkg.zip 503ou em producao.
# Negacao so funciona excluindo o CONTEUDO (/engine/dist/*), nunca o
# diretorio (/engine/dist/) — git nao re-inclui filho de pasta excluida.
/engine/dist/*
!/engine/dist/server.cjs
/node_modules
/out/
/scripts/_*.mjs
engine/installer/MakeIco.exe
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ProPainter models — baixados em runtime pelo Instalar.ps1
engine/subtitle-remover-pkg/propainter/weights/*.pth
engine/subtitle-remover-local/propainter/weights/*.pth

# STTN model — baixado em runtime
engine/subtitle-remover-pkg/sttn/infer_model.pth
engine/subtitle-remover-local/sttn/infer_model.pth
df_test_audio.mp3
.pipe/

# saída da auditoria dev do FakePass (/tools/fakepass/audit)
.dev-fp-audit/
public/dev-tiny.mp4
.next-verify/

# artefatos do teste do Motor macOS no CI
/ci-tmp/

# prints de conferencia do preview (dev-only)
.preview-shots/
